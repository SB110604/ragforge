# Index location (SQLite file)
RAGFORGE_INDEX=data/index.db

# Embeddings: hashing (offline default, no download) | fastembed (pip install 'ragforge[fastembed]') | openai
RAGFORGE_EMBEDDER=hashing
RAGFORGE_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RAGFORGE_EMBED_MODEL=

# Reranker: overlap (default) | cross-encoder (needs the fastembed extra)
RAGFORGE_RERANKER=overlap

# Optional LLM for answers and query rewriting — any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio).
# Leave RAGFORGE_LLM_MODEL empty for extractive answers with citations (no LLM needed).
RAGFORGE_LLM_BASE_URL=http://localhost:11434/v1
RAGFORGE_LLM_API_KEY=
RAGFORGE_LLM_MODEL=
RAGFORGE_LLM_REWRITES=false

# Optional JSON file of synonyms/acronyms used for query rewriting, e.g. {"PO": "purchase order"}
RAGFORGE_GLOSSARY=

# Optional: require header X-API-Key on every API request except /health
RAGFORGE_API_KEY=
